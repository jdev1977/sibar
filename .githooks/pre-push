#!/bin/sh
# Secret scan of the commits about to be pushed.
# Arguments: remote name (or URL) and URL. Standard input, one line per ref:
#   <local ref> <local sha> <remote ref> <remote sha>
# Fails closed: any problem running the scanner blocks the push.

remote=$1
root=$(git rev-parse --show-toplevel) || exit 1
. "$root/.githooks/find-python.sh" || exit 1
find_python "$root" || exit 1

# True for a sha that is not all zeros (git uses zeros for "no object").
exists() {
    case $1 in *[!0]*) return 0 ;; esac
    return 1
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    exists "$local_sha" || continue # deleting a remote ref sends nothing

    if ! git cat-file -e "$local_sha^{commit}" 2>/dev/null; then
        echo "secret-scan: $local_ref is not a commit and cannot be scanned; blocked." >&2
        status=1
        continue
    fi

    if ! exists "$remote_sha"; then
        # New remote ref: everything not already on this remote. For a URL
        # there are no remote-tracking refs, so this is the whole history.
        set -- --range "$local_sha" --exclude-remote "$remote"
    elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        set -- --range "$remote_sha..$local_sha"
    else
        # The remote commit is unknown here: scan the whole history.
        set -- --range "$local_sha"
    fi

    # The scanner must not read the ref list on our standard input.
    "$python" -I "$root/tools/secret_scan.py" "$@" </dev/null || status=1
done
exit $status
