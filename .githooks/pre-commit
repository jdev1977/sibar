#!/bin/sh
# Secret scan of the staged changes. Enable once per clone:
#   git config core.hooksPath .githooks
# Fails closed: any problem running the scanner blocks the commit.

root=$(git rev-parse --show-toplevel) || exit 1
. "$root/.githooks/find-python.sh" || exit 1
find_python "$root" || exit 1
exec "$python" -I "$root/tools/secret_scan.py" --staged
