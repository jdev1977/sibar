# Variable names only. Never put a real value in this file.
# Set the values as environment variables in the shell that runs a command
# (docs/secrets.md, "Setting keys in PowerShell"). No command here reads a
# .env file; a local .env (gitignored) is not loaded.
# Used by the runner and the tagger (models.yaml, tagger/taggers.yaml):
ANTHROPIC_API_KEY=
# Optional, not secret: needed only for an Anthropic key not scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Not used by any command yet (providers considered, not chosen):
XAI_API_KEY=
MISTRAL_API_KEY=

# Multi-provider gateways (not used by any command yet)
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
